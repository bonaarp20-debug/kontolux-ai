"{\"grundlagen\": {\"kleinunternehmerregelung\": {\"paragraph\": \"§19 UStG\", \"umsatzgrenze_vorjahr\": 25000, \"umsatzgrenze_laufendes_jahr\": 100000, \"gilt_seit\": \"01.01.2025 — neue EU-weite Regelung\", \"hinweis\": \"Kleinunternehmer stellen KEINE Umsatzsteuer in Rechnung und haben keinen Vorsteuerabzug. Pflichthinweis auf jeder Rechnung: 'Gemäß §19 UStG wird keine Umsatzsteuer berechnet.'\", \"verzicht_moeglich\": true, \"verzicht_bindung_jahre\": 5, \"eu_grenzueberschreitend\": \"Seit 2025 können Kleinunternehmer aus anderen EU-Ländern auch in Deutschland die Kleinunternehmerregelung nutzen und umgekehrt — bis zu einem EU-weiten Jahresumsatz von 100.000€\", \"neu_2025\": \"Umsatzgrenze wurde von 22.000€ auf 25.000€ erhöht\", \"grenze_100000_sofort\": {\"warnung\": \"KRITISCH — Statuswechsel sofort bei Überschreitung!\", \"regel\": \"Wenn Umsatz im laufenden Jahr 100.000€ übersteigt, endet Kleinunternehmerregelung SOFORT — nicht erst zum Jahresende!\", \"beispiel\": \"Umsatz überschreitet am 15. August 100.000€ → ab dieser Rechnung USt-Pflicht!\", \"konsequenz\": \"Bereits ausgestellte Rechnungen ohne USt müssen ggf. korrigiert werden\", \"empfehlung\": \"Umsatz laufend im Blick behalten — bei 90.000€ Warnung ausgeben\"}, \"verzicht_details\": {\"moeglich\": true, \"sinnvoll_wenn\": [\"Viele B2B-Kunden die Vorsteuer abziehen können\", \"Größere Investitionen geplant\", \"Umsatz nähert sich 25.000€ Grenze\", \"Professionelleres Auftreten gewünscht\"], \"nicht_sinnvoll_wenn\": [\"Hauptsächlich Privatkunden\", \"Wenig eigene Ausgaben mit USt\", \"Geringer Umsatz unter 15.000€\"], \"bindung_jahre\": 5, \"antrag\": \"Beim Finanzamt schriftlich — am besten mit Steuerberater\"}}, \"einkommensteuer_grundfreibetrag\": {\"2024\": 11784, \"2025\": 12096, \"2026\": 12348, \"2026_verheiratet\": 24696, \"hinweis\": \"Grundfreibetrag 2026 = 12.348€ (Singles) / 24.696€ (Ehepaare). Erst darüber fällt Einkommensteuer an.\", \"steigerung_2026\": \"Erhöhung um 252€ gegenüber 2025\"}, \"gewerbesteuer\": {\"freibetrag_einzelunternehmer\": 24500, \"freibetrag_kapitalgesellschaft\": 0, \"hinweis\": \"Einzelunternehmer und Personengesellschaften: Freibetrag 24.500€. GmbH/UG: kein Freibetrag. Hebesatz variiert je Gemeinde (300-500% typisch). Gewerbesteuer mindert Einkommensteuer teilweise.\", \"anrechnung\": \"Gewerbesteuer wird auf die Einkommensteuer angerechnet — bis zu 3,8-faches des Gewerbesteuermessbetrags\", \"vorauszahlungen\": {\"faelligkeiten_2026\": {\"q1\": \"17. Februar 2026\", \"q2\": \"15. Mai 2026\", \"q3\": \"17. August 2026\", \"q4\": \"17. November 2026\"}, \"an_wen\": \"An die Gemeinde — NICHT ans Finanzamt!\", \"nur_fuer\": \"Nur Gewerbetreibende — Freiberufler zahlen KEINE Gewerbesteuer!\"}}, \"solidaritaetszuschlag\": {\"abgeschafft_fuer\": \"Seit 2021 zahlen ca. 90% der Steuerzahler keinen Soli mehr\", \"freigrenze_2026\": 18130, \"hinweis\": \"Nur bei hohem Einkommen noch relevant\"}}, \"umsatzsteuer\": {\"steuersaetze\": {\"regulaer\": 19, \"ermaessigt\": 7, \"befreit\": 0, \"ermaessigt_7_beispiele\": [\"Lebensmittel (außer Getränke im Restaurant, Alkohol)\", \"Bücher, Zeitungen, Zeitschriften (auch E-Books seit 2020)\", \"Kulturveranstaltungen (Theater, Konzerte, Museen, Zoos)\", \"Personennahverkehr (Bus, Bahn bis 50km Entfernung)\", \"Bestimmte medizinische Leistungen (Krankenhaus, Arzt)\", \"Gemeinnützige Leistungen\", \"Übernachtungen (Hotelzimmer — aber nicht Frühstück!)\", \"Kunstgegenstände und Sammlerstücke\", \"Holz aus Forstwirtschaft\", \"Speisen in Restaurants/Gastronomie (NEU seit 01.01.2026!) — Getränke weiterhin 19%!\"], \"befreit_0_beispiele\": [\"Ärztliche Heilbehandlungen §4 Nr. 14 UStG\", \"Schul- und Hochschulunterricht §4 Nr. 21 UStG\", \"Versicherungsleistungen §4 Nr. 10 UStG\", \"Grundstücksverkäufe §4 Nr. 9 UStG\", \"Innergemeinschaftliche Lieferungen §4 Nr. 1b UStG\"]}, \"voranmeldung\": {\"monatlich_wenn\": \"Vorjahres-USt über 7.500€\", \"quartalsweise_wenn\": \"Vorjahres-USt zwischen 1.000€ und 7.500€\", \"jaehrlich_wenn\": \"Vorjahres-USt unter 1.000€\", \"abgabefrist\": \"10. des Folgemonats (bzw. Folgevierteljahrs)\", \"elektronisch\": \"Pflicht — über ELSTER oder Steuerberatersoftware\", \"dauerfristverlaengerung\": {\"beschreibung\": \"Antrag beim Finanzamt verlängert Abgabefrist dauerhaft um einen Monat\", \"antrag\": \"Einmalig stellen — gilt dann dauerhaft bis Widerruf\", \"sondervorauszahlung\": {\"betrag\": \"1/11 der Vorjahres-Umsatzsteuerzahllast\", \"faelligkeit\": \"10. Februar (monatliche Zahler) bzw. 10. Februar (Quartalszahler)\", \"verrechnung\": \"Wird mit der Dezember-UStVA des laufenden Jahres verrechnet\", \"beispiel\": \"Vorjahres-USt 11.000€ → Sondervorauszahlung 1.000€ im Februar\"}, \"wichtig\": \"Bei Dauerfristverlängerung verschiebt sich JEDE UStVA-Frist um einen Monat. Januar-UStVA nicht am 10. Februar sondern am 10. März.\"}}, \"vorsteuer\": {\"beschreibung\": \"Umsatzsteuer die du selbst bezahlt hast (auf Eingangsrechnungen) und vom Finanzamt zurückbekommst\", \"voraussetzungen\": [\"Du bist umsatzsteuerpflichtig (kein Kleinunternehmer)\", \"Du hast eine ordnungsgemäße Rechnung nach §14 UStG\", \"Die Leistung wurde für dein Unternehmen erbracht\", \"Die Rechnung weist Steuerbetrag und Steuersatz aus\"], \"nicht_abzugsfaehig\": [\"Bewirtungskosten über 70% hinaus\", \"Private Nutzungsanteile\", \"Reisekosten ohne ordnungsgemäßen Beleg\"]}, \"reverse_charge\": {\"paragraph\": \"§13b UStG\", \"beschreibung\": \"Steuerschuldnerschaft geht auf den Leistungsempfänger über — der Käufer schuldet die USt ans Finanzamt, nicht der Verkäufer\", \"wann_anwendbar\": [\"Leistungen ausländischer Unternehmer an deutsche Unternehmer (z.B. Google Ads, Anthropic API, AWS, Zoom)\", \"Bestimmte Bauleistungen zwischen Bauunternehmern\", \"Lieferung von Mobilfunkgeräten ab 5.000€ Nettowert\", \"Lieferung von Tablet-Computern ab 5.000€\", \"Lieferung von Spielekonsolen ab 5.000€\", \"Schrottlieferungen und Altmetall\", \"Gebäudereinigungsleistungen zwischen Unternehmern\"], \"buchung_beim_empfaenger\": {\"erklaerung\": \"Der Empfänger bucht SOWOHL Umsatzsteuer ALS AUCH Vorsteuer — beide Beträge sind identisch und heben sich auf (bei vollem Vorsteuerabzugsrecht)\", \"ustva_zeilen\": {\"umsatzsteuer\": \"Zeile 52: Steuer nach §13b UStG (du schuldest die USt)\", \"vorsteuer\": \"Zeile 67: Vorsteuer nach §13b UStG (du ziehst sie gleichzeitig ab)\", \"wichtig\": \"BEIDE Zeilen müssen ausgefüllt werden — nicht nur eine!\"}, \"beispiel\": \"Du kaufst Google Ads für 1.000€ netto. Auf der Rechnung steht 0% USt. Du buchst: 1.000€ Betriebsausgabe + 190€ USt (Zeile 52) + 190€ VSt (Zeile 67). Netto-Effekt: 0€ Steuerlast.\"}, \"auf_eingangsrechnung\": \"Ausländischer Lieferant schreibt 'Reverse Charge' oder 'Steuerschuldnerschaft des Leistungsempfängers' auf der Rechnung und berechnet 0% USt\", \"wichtig\": \"Reverse Charge ist NICHT dasselbe wie innergemeinschaftliche Lieferung!\", \"kleinunternehmer\": {\"wichtig\": \"KLEINUNTERNEHMER UND REVERSE CHARGE — HÄUFIGER IRRTUM!\", \"regel\": \"Kleinunternehmer müssen TROTZDEM eine UStVA stellen wenn sie Reverse-Charge-Leistungen empfangen!\", \"beispiele\": [\"Google Ads\", \"Anthropic API\", \"AWS\", \"Zoom\", \"Adobe Creative Cloud\", \"Shopify\", \"Alle ausländischen Dienstleister\"], \"ustVA_kleinunternehmer\": {\"zeile_52\": \"MUSS ausgefüllt werden — Steuerschuld nach §13b UStG\", \"zeile_67\": \"BLEIBT LEER — Kleinunternehmer haben keinen Vorsteuerabzug!\", \"erklaerung\": \"Kleinunternehmer zahlen die Umsatzsteuer ans Finanzamt aber bekommen sie NICHT zurück. Das ist der Unterschied zu regelbesteuerten Unternehmern die Zeile 52 und 67 beide ausfüllen und sich so die Steuer gegenseitig aufheben.\"}, \"beispiel_google_ads\": \"Google Ads 500€ netto: Kleinunternehmer bucht 500€ Betriebsausgabe + 95€ USt-Schuld (Zeile 52). Die 95€ muss er ans Finanzamt zahlen — er bekommt sie NICHT als Vorsteuer zurück!\", \"nicht_verwechseln\": \"Kein Vorsteuerabzug bedeutet NICHT dass nichts in der UStVA auftaucht. Zeile 52 muss trotzdem ausgefüllt werden!\"}}, \"innergemeinschaftlich\": {\"lieferung_ausgehend\": {\"paragraph\": \"§4 Nr. 1b UStG\", \"beschreibung\": \"Du verkaufst Waren an Unternehmer in anderen EU-Ländern\", \"steuersatz\": 0, \"voraussetzungen\": [\"Käufer hat gültige USt-ID (im VIES-System prüfbar)\", \"Ware wird tatsächlich ins EU-Ausland transportiert\", \"Nachweis des Transports (Lieferschein, CMR etc.)\"], \"auf_rechnung\": \"'Steuerfreie innergemeinschaftliche Lieferung gem. §4 Nr. 1b UStG' + USt-ID des Käufers\", \"zusammenfassende_meldung\": \"Muss in ZM (Zusammenfassende Meldung) gemeldet werden\"}, \"erwerb_eingehend\": {\"paragraph\": \"§1a UStG\", \"beschreibung\": \"Du kaufst Waren von Unternehmern in anderen EU-Ländern\", \"buchung\": \"Ähnlich wie Reverse Charge — USt und VSt buchen\", \"ustva\": \"Zeile 41 (innergemeinschaftliche Erwerbe) UND Zeile 67 (VSt)\"}, \"dienstleistungen\": {\"beschreibung\": \"Bei Dienstleistungen zwischen EU-Unternehmern gilt Reverse Charge (§13b)\", \"beispiel\": \"Französische Agentur erstellt Website für deutsches Unternehmen → Reverse Charge\"}}, \"rechnungspflichtangaben\": {\"paragraph\": \"§14 UStG\", \"pflichtfelder_vollrechnung\": [\"Vollständiger Name und Anschrift des Lieferanten\", \"Vollständiger Name und Anschrift des Empfängers\", \"Steuernummer ODER USt-ID des Lieferanten (eines reicht)\", \"Ausstellungsdatum der Rechnung\", \"Fortlaufende eindeutige Rechnungsnummer\", \"Menge und handelsübliche Bezeichnung der Leistung\", \"Zeitpunkt der Lieferung oder Leistung (Monat reicht oft)\", \"Nach Steuersätzen aufgeschlüsseltes Entgelt (Netto)\", \"Im Voraus vereinbarte Entgeltminderungen (Rabatte, Skonti)\", \"Steuersatz und Steuerbetrag — oder Hinweis auf Steuerbefreiung\", \"Bruttobetrag (Gesamtbetrag)\"], \"kleinbetragsrechnung\": {\"grenze_brutto\": 250, \"vereinfachte_pflichtfelder\": [\"Ausstellungsdatum\", \"Name und Anschrift Lieferant\", \"Menge und Art der Leistung\", \"Entgelt und Steuerbetrag (oder Brutto + Steuersatz)\", \"Steuersatz\"]}, \"gutschrift\": \"Wenn der Leistungsempfänger die Rechnung ausstellt (umgekehrte Rechnung) — muss als 'Gutschrift' bezeichnet werden\"}}, \"einkommensteuer\": {\"euer\": {\"name\": \"Einnahmen-Überschuss-Rechnung\", \"paragraph\": \"§4 Abs. 3 EStG\", \"wer_darf\": \"Freiberufler (immer), Gewerbetreibende bis 60.000€ Gewinn ODER 600.000€ Umsatz im Vorjahr\", \"wer_muss_bilanz\": \"GmbH, UG, AG immer. Gewerbetreibende über den Grenzen.\", \"prinzip\": \"Zufluss-Abfluss-Prinzip: Einnahmen und Ausgaben zählen wenn Geld fließt (nicht wenn Rechnung gestellt wird)\", \"abgabe\": \"Anlage EÜR zur Einkommensteuererklärung, elektronisch via ELSTER\", \"frist\": \"31. Juli des Folgejahres (mit Steuerberater: 28./29. Februar übernächstes Jahr)\"}, \"betriebsausgaben\": {\"sofort_abzugsfaehig\": [\"Büromaterial, Druckerpatronen, Papier\", \"Software-Abonnements (monatlich/jährlich)\", \"Telefon und Internet (bei privater Mitnutzung nur betrieblicher Anteil)\", \"Fachliteratur und Fachzeitschriften\", \"Fortbildungskosten (Kurse, Seminare, Webinare)\", \"Werbung und Marketing (Google Ads, Social Media Ads, Drucksachen)\", \"Buchhalter und Steuerberater\", \"Kontoführungsgebühren (Geschäftskonto)\", \"Versicherungen (betriebliche: Berufshaftpflicht, Betriebshaftpflicht)\", \"Porto und Versandkosten\", \"Reisekosten (Fahrtkosten, Übernachtung, Verpflegungspauschale)\", \"Geschäftliche Bewirtung (70% des Nettobetrags)\", \"Arbeitskleidung (wenn ausschließlich beruflich)\", \"Mitgliedsbeiträge (Berufsverbände, IHK)\"], \"homeoffice\": {\"tagespauschale\": 6, \"max_tage\": 210, \"max_betrag\": 1260, \"gilt_seit\": \"2023 — vereinfachte Regelung\", \"alternativ\": \"Tatsächliche anteilige Kosten wenn separates Arbeitszimmer (Miete, Nebenkosten, Strom anteilig nach Fläche)\"}, \"fahrtkosten\": {\"km_pauschale_1_20\": 0.3, \"km_pauschale_ab_21\": 0.38, \"hinweis\": \"Für Fahrten zwischen Wohnung und erster Tätigkeitsstätte (Pendlerpauschale). Für Dienstreisen gilt die tatsächliche Entfernung vollständig.\", \"fahrtenbuch\": \"Alternativ tatsächliche Kosten mit Fahrtenbuch (aufwändiger aber oft günstiger bei neuem/teurem Auto)\"}, \"verpflegungspauschale\": {\"8_bis_24_stunden\": 14, \"ab_24_stunden\": 28, \"anreisetag\": 14, \"abreisetag\": 14, \"hinweis\": \"Gilt bei Abwesenheit von Wohnung und erster Tätigkeitsstätte\"}, \"bewirtungskosten\": {\"abzugsfaehig\": 0.7, \"nachweis\": \"Bewirtungsbeleg mit: Datum, Ort, Anlass, Teilnehmer, Betrag — muss zeitnah ausgefüllt werden\", \"nicht_abzugsfaehig\": \"Bewirtung von Arbeitnehmern im Rahmen von Betriebsveranstaltungen (andere Regelung)\"}, \"fahrtkosten_2026\": {\"aenderung_ab_2026\": \"Erhöhte Pendlerpauschale ab 01.01.2026\", \"km_1_20\": 0.32, \"km_ab_21\": 0.4, \"vorher_2025\": \"0,30€ und 0,38€\", \"hinweis\": \"Gilt für Fahrten zwischen Wohnung und erster Tätigkeitsstätte\"}}, \"abschreibungen\": {\"afa\": {\"name\": \"Absetzung für Abnutzung\", \"beschreibung\": \"Wirtschaftsgüter über 800€ netto werden über ihre Nutzungsdauer verteilt abgeschrieben\", \"afa_tabelle\": \"Finanzverwaltung gibt Nutzungsdauern vor (z.B. PC 3 Jahre, PKW 6 Jahre, Büromöbel 13 Jahre)\", \"beispiel\": \"Laptop für 1.200€ netto, Nutzungsdauer 3 Jahre → 400€ Abschreibung pro Jahr\"}, \"gwg\": {\"name\": \"Geringwertige Wirtschaftsgüter\", \"paragraph\": \"§6 Abs. 2 EStG\", \"grenze_sofortabzug_netto\": 800, \"grenze_sofortabzug_brutto_19\": 952, \"grenze_sofortabzug_brutto_7\": 856, \"unter_250_netto\": \"Immer Sofortabzug (Vereinfachungsregel)\", \"250_bis_800_netto\": \"Wahlrecht: Sofortabzug ODER Sammelposten über 5 Jahre\", \"ueber_800_netto\": \"Pflicht zur Abschreibung über Nutzungsdauer\", \"wichtig\": \"GRENZE IST 800€ NETTO — nicht 1.000€! Häufiger Irrtum! Grenze gilt seit 2018.\", \"selbstaendig_nutzbar\": \"Wirtschaftsgut muss selbstständig nutzbar sein (z.B. Laptop ja, RAM-Erweiterung nein)\"}, \"sonderabschreibung\": {\"paragraph\": \"§7g EStG\", \"beschreibung\": \"Kleine und mittlere Unternehmen können bis zu 50% der Anschaffungskosten bereits vor der Anschaffung abschreiben (Investitionsabzugsbetrag) oder im Anschaffungsjahr zusätzlich zur normalen AfA\", \"voraussetzung\": \"Betriebsvermögen unter 200.000€\"}}, \"vorauszahlungen\": {\"beschreibung\": \"Selbstständige zahlen Einkommensteuer vierteljährlich im Voraus — nicht einmal jährlich!\", \"faelligkeiten_2026\": {\"q1\": \"10. März 2026\", \"q2\": \"10. Juni 2026\", \"q3\": \"10. September 2026\", \"q4\": \"10. Dezember 2026\"}, \"berechnung\": \"Finanzamt teilt letzte Jahressteuer durch 4. Erste Vorauszahlung nach erstem Steuerbescheid.\", \"mindestbetrag\": \"Nur wenn Jahressteuer mindestens 400€ und Quartalsrate mindestens 100€ (§37 Abs. 5 EStG)\", \"neugruender\": \"Im ersten Jahr schätzt Finanzamt den voraussichtlichen Gewinn\", \"anpassung\": \"Vorauszahlungen können beim Finanzamt angepasst werden wenn Gewinn stark schwankt\", \"wichtig\": \"Das Finanzamt schickt KEINE Zahlungserinnerung! SEPA-Lastschrift empfehlenswert um Säumniszuschläge zu vermeiden.\", \"steuersaetze_2026\": {\"grundfreibetrag\": 12348, \"grundfreibetrag_verheiratet\": 24696, \"zone_1\": \"0% bis 12.348€\", \"zone_2\": \"14-23,97% von 12.349€ bis 17.799€\", \"zone_3\": \"23,97-42% von 17.800€ bis 69.878€\", \"spitzensteuersatz\": \"42% ab 69.879€\", \"reichensteuer\": \"45% ab 277.826€\", \"soli_freigrenze_2026\": 20350}}}, \"gwg\": {\"zusammenfassung\": \"GWG-Grenze = 800€ NETTO (nicht 1.000€!). Gilt seit 2018.\", \"details\": \"Siehe einkommensteuer.abschreibungen.gwg\"}, \"aufbewahrungsfristen\": {\"10_jahre_buchhaltungsunterlagen\": [\"Bücher und Aufzeichnungen\", \"Jahresabschlüsse und Bilanzen\", \"Inventare\", \"Eröffnungsbilanzen\", \"Lageberichte\", \"Arbeitsanweisungen und Verfahrensdokumentation\"], \"8_jahre_buchungsbelege_seit_2025\": [\"Eingangsrechnungen\", \"Ausgangsrechnungen\", \"Kontoauszüge\", \"Kassenbelege und Quittungen\", \"Lie